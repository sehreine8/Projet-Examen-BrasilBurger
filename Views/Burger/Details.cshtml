@model BrasilBurgerClient.Models.Burger

@{
    ViewData["Title"] = Model.Nom;
}

<div class="container my-5">

    <div class="row d-flex justify-content-center">

        <!-- IMAGE -->
        <div class="col-md-6">
            <img src="@Model.ImageUrl"
                 alt="@Model.Nom"
                 class="rounded-4 shadow-sm w-100"
                 style="height:480px; object-fit:cover;">
        </div>

        <!-- INFOS -->
        <div class="col-md-6">

            <div class="bg-white shadow-sm rounded-4 p-4">

                <!-- TITRE + PRIX -->
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h4 class="fw-bold">@Model.Nom</h4>
                    <div class="text-end">
                        <h5 class="fw-bold text-warning">@Model.Prix xof</h5>
                        <span class="text-muted small">Prix unitaire</span>
                    </div>
                </div>

                <!-- DESCRIPTION -->
                <p class="text-muted mb-4">
                    @Model.Description
                </p>

                <!-- INGRÉDIENTS -->
                <h6 class="fw-bold">Ingrédients</h6>
                <div class="row small mb-4">
                    <div class="col-6">
                        <p class="mb-1"><i class="bi bi-check2 text-warning"></i> Viande de boeuf</p>
                        <p class="mb-1"><i class="bi bi-check2 text-warning"></i> Tomate</p>
                        <p class="mb-1"><i class="bi bi-check2 text-warning"></i> Sauce artisanale</p>
                    </div>
                    <div class="col-6">
                        <p class="mb-1"><i class="bi bi-check2 text-warning"></i> Laitue</p>
                        <p class="mb-1"><i class="bi bi-check2 text-warning"></i> Oignons caramélisés</p>
                        <p class="mb-1"><i class="bi bi-check2 text-warning"></i> Pain brioché</p>
                    </div>
                </div>

                <hr />

                <!-- QUANTITÉ -->
                <div class="mb-4">
                    <h6 class="fw-bold">Quantité</h6>

                    <div class="d-flex align-items-center">

                        <button class="btn btn-outline-secondary rounded-circle me-3 qty-btn" onclick="decrease()">
                            <i class="bi bi-dash"></i>
                        </button>

                        <span id="qty" class="fw-bold fs-5">1</span>

                        <button class="btn btn-outline-secondary rounded-circle ms-3 qty-btn" onclick="increase()">
                            <i class="bi bi-plus"></i>
                        </button>

                    </div>
                </div>

                <!-- TOTAL -->
                <div class="d-flex justify-content-between mb-4">
                    <h6 class="fw-bold">Total</h6>
                    <h6 id="total" class="fw-bold text-warning">
                        @Model.Prix xof
                    </h6>
                </div>

                <!-- BOUTON PANIER -->
                <a class="btn btn-warning w-100 fw-bold rounded-3">
                    <i class="bi bi-plus-circle me-2"></i> Ajouter au panier
                </a>

            </div>
        </div>

    </div>
</div>


@section Scripts {
    <script>
        let price = @Model.Prix;
        let qty = 1;

        function updateTotal() {
            document.getElementById("total").textContent = (price * qty) + " xof";
            document.getElementById("qty").textContent = qty;
        }

        function increase() { qty++; updateTotal(); }
        function decrease() { if (qty > 1) qty--; updateTotal(); }
    </script>
}
