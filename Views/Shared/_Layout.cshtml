<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Brasil Burger</title>

    <!-- BOOTSTRAP & ICONS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <!-- CSS APP -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BrasilBurgerClient.styles.css" asp-append-version="true" />
</head>

<body style="background-color: #f8f9fa;">

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg bg-white shadow-sm py-3">
        <div class="container">

            <!-- LOGO -->
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index" style="color: #FFCC00;">
                🍔 Brasil Burger
            </a>

            <!-- MOBILE TOGGLE -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarNav" aria-controls="navbarNav"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- NAV LINKS -->
            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav ms-auto me-3 mb-2 mb-lg-0">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Accueil</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Burger" asp-action="Index">Burgers</a>

                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Menu" asp-action="Index">Menus</a>

                    </li>

                </ul>

                <!-- RIGHT BUTTONS -->
                <div class="d-flex align-items-center gap-3">

                    <!-- PANIER -->
                    <a href="#" data-bs-toggle="offcanvas" 
                        class="btn btn-warning rounded-pill px-3">
                        <i class="bi bi-bag"></i>
                        Panier
                    </a>


                    <!-- PROFIL -->
                    <a asp-controller="Profil" asp-action="Index"
                       class="btn btn-outline-dark rounded-pill px-3">
                        <i class="bi bi-person"></i>
                        Profil
                    </a>

                </div>

            </div>
        </div>
    </nav>

    <!-- PAGE CONTENT -->
    <main>
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="border-top py-3 text-center text-muted">
        &copy; 2025 - Brasil Burger
    </footer>

    <!-- JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)


 <!-- 🟡 POP-UP PANIER -->
    <div class="offcanvas offcanvas-end shadow" tabindex="-1" id="cartCanvas">
        <div class="offcanvas-header">
            <h6 class="offcanvas-title fw-bold">
                <i class="bi bi-bag-fill text-warning me-2"></i> Mon Panier
            </h6>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>

        <div class="offcanvas-body">

            <!-- LISTE ARTICLES -->
            <div id="cart-items"></div>

            <hr />

            <!-- SOUS TOTAL -->
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted small">Sous-total</span>
                <span id="cart-subtotal" class="fw-bold small">0 xof</span>
            </div>

            <!-- FRAIS LIVRAISON -->
            <div class="d-flex justify-content-between mb-3">
                <span class="text-muted small">Frais de livraison</span>
                <span id="cart-fees" class="fw-bold small">1.000 xof</span>
            </div>

            <hr />

            <!-- TOTAL -->
            <div class="d-flex justify-content-between mb-4">
                <h6 class="fw-bold">Total</h6>
                <h6 id="cart-total" class="fw-bold text-warning">0 xof</h6>
            </div>

            <!-- BOUTON COMPLEMENT (APPARAÎT SEULEMENT SI PANIER > 0) -->
            <a href="/Complement" 
            id="btn-complement" 
            class="btn btn-outline-dark w-100 mb-2 d-none">
            Ajouter un complément
            </a>

            <!-- BOUTON COMMANDE -->
            <a class="btn btn-warning w-100 fw-bold">
                Valider ma commande
            </a>

            <a class="btn btn-light w-100 mt-2 small text-muted">
                Continuer mes achats
            </a>

        </div>
    </div>

    <script>
    let cart = [];

    function addToCart(name, price, image, qty = 1) {

        cart.push({ name, price, image, qty });

        updateCartUI();
    }

    function updateCartUI() {

        const body = document.getElementById("cart-items");
        body.innerHTML = "";

        let subtotal = 0;

        cart.forEach((item, i) => {

            subtotal += item.price * item.qty;

            body.innerHTML += `
                <div class="d-flex align-items-center mb-3">
                    <img src="${item.image}" style="width:60px;height:60px;object-fit:cover;border-radius:8px;">
                    <div class="ms-2 flex-grow-1">
                        <span class="fw-bold small d-block">${item.name}</span>
                        <span class="text-muted small">${item.price} xof</span>
                    </div>
                    <span class="fw-bold text-warning">${item.price * item.qty} xof</span>
                </div>
            `;
        });

        // TOTAL
        document.getElementById("cart-subtotal").textContent = subtotal + " xof";
        document.getElementById("cart-total").textContent = (subtotal + 1000) + " xof";

        // COMPLEMENT BUTTON
        document.getElementById("btn-complement")
                .classList.toggle("d-none", cart.length === 0);
    }
</script>


</body>
</html>
