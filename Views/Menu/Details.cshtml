@model BrasilBurgerClient.Models.Menu

@{
    ViewData["Title"] = Model.Nom;
}

<div class="container my-5">

    <div class="row d-flex justify-content-center">

        <!-- IMAGE -->
        <div class="col-md-6">
            <img src="@Model.ImageUrl"
                 alt="@Model.Nom"
                 class="rounded-4 shadow-sm w-100"
                 style="height:480px; object-fit:cover;">
        </div>

        <!-- INFOS -->
        <div class="col-md-6">

            <div class="bg-white shadow-sm rounded-4 p-4">

                <!-- TITRE + PRIX -->
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h4 class="fw-bold">@Model.Nom</h4>

                    <div class="text-end">
                        <h5 class="fw-bold text-warning">@Model.PrixTotal xof</h5>
                        <span class="text-muted small">Prix du menu</span>
                    </div>
                </div>

                <!-- DESCRIPTION -->
                <p class="text-muted mb-4">
                    @Model.Description
                </p>

                <!-- COMPOSITION -->
                <h6 class="fw-bold mb-3">Composition du menu</h6>

                <div class="d-flex align-items-start mb-2">
                    <i class="bi bi-egg-fried text-warning me-3 fs-4"></i>
                    <div class="flex-grow-1">
                        <span class="fw-bold small">Burger</span><br />
                        <span class="text-muted small">@Model.Burger.Nom</span>
                    </div>
                    <i class="bi bi-check-lg text-success fs-4"></i>
                </div>

                <div class="d-flex align-items-start mb-2">
                    <i class="bi bi-cup-straw text-warning me-3 fs-4"></i>
                    <div class="flex-grow-1">
                        <span class="fw-bold small">Boisson</span><br />
                        <span class="text-muted small">@Model.Boisson.Nom</span>
                    </div>
                    <i class="bi bi-check-lg text-success fs-4"></i>
                </div>

                <div class="d-flex align-items-start mb-4">
                    <i class="bi bi-emoji-smile text-warning me-3 fs-4"></i>
                    <div class="flex-grow-1">
                        <span class="fw-bold small">Accompagnements</span><br />
                        <span class="text-muted small">@Model.Frites.Nom</span>
                    </div>
                    <i class="bi bi-check-lg text-success fs-4"></i>
                </div>

                <hr />


                <!-- QUANTITÉ -->
                <div class="mb-4">
                    <h6 class="fw-bold">Quantité</h6>

                    <div class="d-flex align-items-center">

                        <button class="btn btn-outline-secondary rounded-circle me-3 qty-btn" onclick="decrease()">
                            <i class="bi bi-dash"></i>
                        </button>

                        <span id="qty" class="fw-bold fs-5">1</span>

                        <button class="btn btn-outline-secondary rounded-circle ms-3 qty-btn" onclick="increase()">
                            <i class="bi bi-plus"></i>
                        </button>

                    </div>
                </div>

                <!-- TOTAL -->
                <div class="d-flex justify-content-between mb-4">
                    <h6 class="fw-bold">Total</h6>
                    <h6 id="total" class="fw-bold text-warning">
                        @Model.PrixTotal xof
                    </h6>
                </div>

                <!-- BOUTON PANIER -->
                <a class="btn btn-warning w-100 fw-bold rounded-3">
                    <i class="bi bi-plus-circle me-2"></i> Ajouter au panier
                </a>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        let price = @Model.PrixTotal;
        let qty = 1;

        function updateTotal() {
            document.getElementById("total").textContent = (price * qty) + " xof";
            document.getElementById("qty").textContent = qty;
        }

        function increase() { qty++; updateTotal(); }
        function decrease() { if (qty > 1) qty--; updateTotal(); }
    </script>
}
