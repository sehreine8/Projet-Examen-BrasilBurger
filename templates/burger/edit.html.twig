{% extends 'layout/admin.html.twig' %}

{% block title %}Modifier un burger{% endblock %}
{% block page_title %}Modifier{% endblock %}

{% block body %}

<div class="card shadow-sm border-0">
    <div class="card-body">
        <h5 class="fw-bold mb-3">Modifier le burger</h5>

        {{ form_start(form) }}
            {{ form_widget(form) }}

            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-warning">Enregistrer</button>
                <a href="{{ path('burger_list') }}" class="btn btn-outline-secondary">
                    Annuler
                </a>
            </div>
        {{ form_end(form) }}
    </div>
</div>

{% endblock %}
