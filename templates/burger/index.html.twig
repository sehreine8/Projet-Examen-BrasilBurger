{% extends 'layout/admin.html.twig' %}

{% block title %}Burgers{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">Gestion des Burgers</h4>
        <small class="text-muted">Gérez les burgers et leurs informations</small>
    </div>

    <button class="btn btn-warning fw-semibold"
            data-bs-toggle="modal"
            data-bs-target="#addBurgerModal">
        + Ajouter un burger
    </button>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">

        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Image</th>
                    <th>Nom</th>
                    <th>Prix</th>
                    <th>État</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>

            <tbody>
                {% for burger in burgers %}
                    <tr>
                        <td class="ps-4">
                            <img src="{{ burger.imageUrl }}" class="burger-img">
                        </td>
                        <td>{{ burger.nom }}</td>
                        <td>{{ burger.prix }} XOF</td>
                        <td>
                            <span class="badge badge-active">Actif</span>
                        </td>
                        <td class="text-end pe-4">
                           <a href="#"
                            data-id="{{ burger.id }}"
                            data-bs-toggle="modal"
                            data-bs-target="#editBurgerModal">
                                <i class="bi bi-pencil-square me-2"></i>
                            </a>

                            <i class="bi bi-trash text-danger"></i>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            Aucun burger trouvé
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {% if totalPages > 1 %}
            <nav class="mt-4">
                <ul class="pagination justify-content-center">

                    <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
                        <a class="page-link"
                           href="{{ path('burger_list', { page: currentPage - 1 }) }}">
                            Précédent
                        </a>
                    </li>

                    {% for p in 1..totalPages %}
                        <li class="page-item {% if p == currentPage %}active{% endif %}">
                            <a class="page-link"
                               href="{{ path('burger_list', { page: p }) }}">
                                {{ p }}
                            </a>
                        </li>
                    {% endfor %}

                    <li class="page-item {% if currentPage == totalPages %}disabled{% endif %}">
                        <a class="page-link"
                           href="{{ path('burger_list', { page: currentPage + 1 }) }}">
                            Suivant
                        </a>
                    </li>

                </ul>
            </nav>
        {% endif %}

    </div>
</div>

{# ===== MODALE : DOIT ÊTRE DANS LE BODY ===== #}
<div class="modal fade" id="addBurgerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Ajouter un burger</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                {% include 'burger/_form.html.twig' with { form: form } %}
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="editBurgerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Modifier</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="editBurgerContent">
                <div class="text-center text-muted py-4">
                    Chargement...
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="editBurgerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Modifier le burger</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="editBurgerContent">
                <div class="text-center text-muted py-4">
                    Chargement...
                </div>
            </div>

        </div>
    </div>
</div>


{% endblock %}
