{% extends 'base.html.twig' %}

{% block layout %}

<div class="app-layout">

    <!-- SIDEBAR -->
    <aside class="app-sidebar">
        <div class="sidebar-brand">
            <strong>Brasil Burger</strong>
            
        </div>

        <nav class="sidebar-menu">
            <a href="/dashboard" class="menu-item">Dashboard</a>
            <a href="/burgers" class="menu-item active">Burgers</a>
            <a href="/menus" class="menu-item">Menus</a>
            <a href="/complements" class="menu-item">Compléments</a>
            <a href="/commandes" class="menu-item">Commandes</a>
            <a href="/zones" class="menu-item">Zones</a>
        </nav>

        <div class="sidebar-footer">
            <a href="/logout">Déconnexion</a>
        </div>
    </aside>

    <!-- MAIN -->
    <div class="app-main">

        <!-- TOPBAR -->
        <header class="app-topbar">
            <h1 class="page-title">{% block page_title %}Dashboard{% endblock %}</h1>

            <div class="topbar-actions">
                <i class="bi bi-bell"></i>
                <div class="profile">
                    <strong>Gestionnaire</strong>
                    <small>admin@brasilburger.com</small>
                </div>
            </div>
        </header>

        <!-- CONTENT -->
        <main class="app-content">
            {% block body %}{% endblock %}
        </main>

    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {

    const editModal = document.getElementById('editBurgerModal');
    if (!editModal) return;

    editModal.addEventListener('show.bs.modal', function (event) {

        const trigger = event.relatedTarget;
        const burgerId = trigger.getAttribute('data-id');

        const content = document.getElementById('editBurgerContent');
        content.innerHTML = '<div class="text-center text-muted py-4">Chargement...</div>';

        fetch(`/burgers/${burgerId}/edit`)
            .then(response => response.text())
            .then(html => {
                content.innerHTML = html;
            });
    });

});
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('editBurgerModal');
    if (!modal) return;

    modal.addEventListener('show.bs.modal', event => {
        const button = event.relatedTarget;
        const burgerId = button.getAttribute('data-id');
        const content = document.getElementById('editBurgerContent');

        content.innerHTML = 'Chargement...';

        fetch(`/burgers/${burgerId}/edit`)
            .then(r => r.text())
            .then(html => content.innerHTML = html);
    });
});
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('archiveBurgerModal');
    const form  = document.getElementById('archiveBurgerForm');

    if (!modal || !form) return;

    modal.addEventListener('show.bs.modal', event => {
        const button = event.relatedTarget;
        const burgerId = button.getAttribute('data-id');

        form.action = `/burgers/${burgerId}/archive`;
    });
});
</script>



{% endblock %}
